# Cô Sign settings. Copy this file to .env.local and fill in what you use.
# Every setting has one line above it: required|optional · adapter · what it is for.
# Blank means "use the default" (named in the comment) or "feature off".
# Never commit real keys: secrets stay blank here.

# ---------------------------------------------------------------------------
# App address
# ---------------------------------------------------------------------------

# required · none · Public address of the app, used for links in emails, sign-in redirects, signing links and cron calls back to the app (lib/email.js falls back to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# optional · none · Fallback app address for signing links when NEXT_PUBLIC_APP_URL is blank (pages/api/sessions/create.js; used before the request's Host header)
NEXT_PUBLIC_SITE_URL=

# optional · none · Support address shown on the legal, billing and form pages (default support@example.com, lib/contact.js)
NEXT_PUBLIC_SUPPORT_EMAIL=

# optional · vercel · set by the platform: production host name, used for signing links when NEXT_PUBLIC_APP_URL and NEXT_PUBLIC_SITE_URL are blank (pages/api/sessions/create.js)
# VERCEL_PROJECT_PRODUCTION_URL=

# ---------------------------------------------------------------------------
# Runtime (set by the platform; leave commented out)
# ---------------------------------------------------------------------------

# optional · none · set by the platform: development or production; turns on secure cookies and the Upstash warning in production, and gates the dev login
# NODE_ENV=

# optional · none · set by the platform: nodejs or edge; picks which Sentry config instrumentation.js loads, and the OCR worker starts only on nodejs
# NEXT_RUNTIME=

# optional · vercel · set by the platform: set on Vercel; while it is set the first-run setup is done in the Vercel dashboard, so instrumentation.js makes no one-time setup code at boot
# VERCEL=

# ---------------------------------------------------------------------------
# Database (Supabase)
# ---------------------------------------------------------------------------

# required · supabase · Your Supabase project's API URL (blank leaves the client on a placeholder address and every database call fails)
NEXT_PUBLIC_SUPABASE_URL=

# required · supabase · Supabase anon (public) key, used by the browser client and the OCR page-rendering calls
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# required · supabase · Supabase service role key for server-side admin work; keep it secret, never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# optional · none · Database address the server reads when it starts; when blank the server uses NEXT_PUBLIC_SUPABASE_URL (lib/supabaseEnv.js). Set it for home hosting, where one built app runs against any database
SUPABASE_URL=

# optional · none · Public (anon) key the server reads when it starts; when blank the server uses NEXT_PUBLIC_SUPABASE_ANON_KEY (lib/supabaseEnv.js)
SUPABASE_ANON_KEY=

# optional · none · Database address the browser uses, handed to it by the running server at /api/runtime-config.js; blank means the same origin as the page (lib/supabaseEnv.js)
PUBLIC_SUPABASE_URL=

# optional · none · script only: scripts/db/migrate.js, scripts/db/schemaCheck.js, scripts/db/rlsCheck.js; Postgres address the migration runner builds the database in and the schema and RLS checks read (all refuse to run when blank)
DATABASE_URL=

# optional · none · script only: scripts/db/migrate.js, scripts/db/rlsCheck.js; 1 lets the migration runner and the RLS check run against a *.supabase.co host (default: refused)
MIGRATE_ALLOW_REMOTE=

# ---------------------------------------------------------------------------
# Access and sign-in
# ---------------------------------------------------------------------------

# optional · none · Comma-separated owner emails for the dashboard and admin APIs on the server; blank falls back to NEXT_PUBLIC_OWNER_EMAILS, and no list means every admin request answers 403
ADMIN_DASHBOARD_EMAILS=

# optional · none · Comma-separated owner emails the server reads when ADMIN_DASHBOARD_EMAILS is blank; the browser asks /api/admin/me and does not need it
NEXT_PUBLIC_OWNER_EMAILS=

# optional · supabase · true shows the SAML single sign-on button on the enterprise login page (needs Supabase SSO set up; default off)
NEXT_PUBLIC_SSO_ENABLED=

# optional · none · true rejects embedded signing requests whose origin is missing or does not match the session's embed origin (default false: log only)
COSIGN_EMBED_ORIGIN_STRICT=

# optional · none · Session tokens are looked up by hash only (default true); set false only to allow legacy plaintext-token rows while migrating
COSIGN_SESSION_TOKEN_HASH_STRICT=

# ---------------------------------------------------------------------------
# AI provider and OCR tuning
# ---------------------------------------------------------------------------

# required · anthropic · Anthropic API key for field detection, explanations, translation and the form chat (OCR and translation fail without it)
ANTHROPIC_API_KEY=

# optional · anthropic · How many recent chat turns are resent to the model with each message (default 16, minimum 2)
CHAT_MAX_HISTORY_TURNS=

# optional · anthropic · set to stub for tests: fixed fields, no AI call; never for real use
OCR_PROVIDER=

# optional · anthropic · Time limit in ms for each Anthropic call made by the OCR pipeline (default 30000)
OCR_ANTHROPIC_TIMEOUT_MS=

# optional · anthropic · Model for field labeling, step 2 (default claude-sonnet-4-5)
OCR_STEP2_PRIMARY_MODEL=

# optional · anthropic · Model tried when the step 2 model fails (default claude-haiku-4-5)
OCR_STEP2_FALLBACK_MODEL=

# optional · anthropic · Fields per step 2 labeling call (default 40)
OCR_STEP2_LABEL_CHUNK_SIZE=

# optional · anthropic · Step 2 labeling calls run at the same time (default 5)
OCR_STEP2_CONCURRENCY=

# optional · anthropic · Model for field explanations and translation, step 3 (default claude-haiku-4-5)
OCR_STEP3_PRIMARY_MODEL=

# optional · anthropic · Model tried when the step 3 model fails (default claude-sonnet-4-5)
OCR_STEP3_FALLBACK_MODEL=

# optional · anthropic · Fields per step 3 explanation or translation call (default 10)
OCR_STEP3_CHUNK_SIZE=

# optional · anthropic · Step 3 calls run at the same time (default 6)
OCR_STEP3_CONCURRENCY=

# optional · anthropic · Most fields enriched after setup, and most fields checked for translations when a signing session is created; 0 means no cap in OCR (default 80)
OCR_POST_SETUP_MAX_FIELDS=

# optional · anthropic · Fields per enrichment slice, with a time-budget check between slices (default 120)
OCR_ENRICH_CHUNK_SIZE=

# optional · anthropic · PDF pages sent per call when detecting fields from the text layer (default 2)
OCR_TEXT_PAGES_PER_BATCH=

# optional · anthropic · Time limit in ms for each text-layer detection call (default 60000)
OCR_TEXT_LAYER_TIMEOUT_MS=

# optional · anthropic · Most pages rendered for vision detection of scanned or XFA forms (default 10)
OCR_VISION_DETECT_MAX_PAGES=

# optional · anthropic · Most pages rendered to give technical field names readable labels (default 8)
OCR_VISION_LABEL_MAX_PAGES=

# optional · anthropic · Horizontal strips each page image is cut into for vision detection (default 4, minimum 2)
OCR_VISION_TILE_ROWS=

# optional · anthropic · 1 turns on OCR-anchored field positions for scanned PDFs (Tesseract word boxes); default off, vision grid used
OCR_VISION_USE_OCR_ANCHOR=

# optional · none · false turns off parking long OCR jobs for the resume cron (default on)
OCR_RESUMABLE_ENABLED=

# optional · none · Time in ms one OCR call works before it parks the job for the cron (default 180000, lib/ocrResume.js)
OCR_SOFT_BUDGET_MS=

# optional · none · OCR attempts on one document before OCR gives up on it (default 8, lib/ocrResume.js)
OCR_MAX_ATTEMPTS=

# optional · none · off stops the in-process OCR worker that instrumentation.js starts at boot to resume parked OCR jobs (default on)
OCR_WORKER=

# optional · none · Time in ms between OCR worker passes over parked jobs (default 30000)
OCR_WORKER_INTERVAL_MS=

# optional · none · set by the platform or your shell: port the app listens on; the OCR worker posts to /api/ocr on 127.0.0.1 at this port (default 3000)
# PORT=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

# optional · resend · resend sends mail through Resend; anything else, or blank, only logs mail to the console (default console)
EMAIL_PROVIDER=

# optional · resend · Sender shown on outgoing mail, such as Cô Sign <noreply@example.com>; needed when EMAIL_PROVIDER=resend: there is no built-in sender, and with it blank no mail is sent (lib/email.js logs why)
EMAIL_FROM=

# optional · resend · Resend API key; needed when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Error monitoring (Sentry; inert while the DSNs are blank)
# ---------------------------------------------------------------------------

# optional · sentry · Server and edge Sentry DSN; blank turns server error reporting off
SENTRY_DSN=

# optional · sentry · Browser Sentry DSN; blank turns browser error reporting off
NEXT_PUBLIC_SENTRY_DSN=

# optional · sentry · Share of server and edge requests traced, 0 to 1 (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=

# optional · sentry · Share of browser page loads traced, 0 to 1 (default 0.1)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# optional · sentry · Sentry organization slug for the build-time source map upload
SENTRY_ORG=

# optional · sentry · Sentry project slug for the build-time source map upload
SENTRY_PROJECT=

# optional · sentry · Sentry auth token for the build-time source map upload; keep it secret
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Rate limiting (Upstash; without it limits are in memory, per instance)
# ---------------------------------------------------------------------------

# optional · upstash · Upstash Redis REST URL for rate limits shared across instances
UPSTASH_REDIS_REST_URL=

# optional · upstash · Upstash Redis REST token, needed with the URL
UPSTASH_REDIS_REST_TOKEN=

# optional · none · How many reverse proxies in front of the app append to X-Forwarded-For; the client address for rate limits and the audit trail is the entry this many places from the right (default 1: the Docker stack's gateway, or Vercel's edge; 0 when nothing is in front, then the connection's address is used; lib/clientIp.js)
COSIGN_TRUSTED_PROXY_HOPS=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------

# required · none · Secret the cron routes accept as a Bearer token; retention runs only where something calls /api/cron/retention with it: Vercel Cron does (vercel.json), the Docker stack does not, so schedule the call yourself there (README, Retention); retention answers 503 without it or the secrets below
CRON_SECRET=

# optional · none · Second secret lib/cronAuth.js accepts, used when CRON_SECRET is blank
PROCESS_OCR_CRON_SECRET=

# optional · none · Own secret for the retention cron at /api/cron/retention, accepted alongside CRON_SECRET
RETENTION_CRON_SECRET=

# ---------------------------------------------------------------------------
# Development and test only (not needed to run the app)
# ---------------------------------------------------------------------------

# optional · none · Development only: true shows the dev login on the enterprise login page when NODE_ENV=development (default off)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=

# optional · none · Development only: account the dev login signs in as (default admin@example.com, lib/devLogin.js)
NEXT_PUBLIC_DEV_LOGIN_EMAIL=

# optional · none · script only: scripts/seed-dev.js; true lets the dev seed run (it refuses otherwise, and always in production)
ENABLE_DEV_SEED=

# optional · none · script only: scripts/test-enterprise-flow.js; app address to test against (default http://localhost:3000)
BASE_URL=

# optional · none · script only: scripts/test-enterprise-flow.js; document id to test with, or pass it as the first argument
TEST_DOCUMENT_ID=

# optional · none · script only: scripts/test-enterprise-flow.js; signed-in user's token, or pass it as the second argument; keep it secret
TEST_USER_JWT=

# optional · none · script only: scripts/positioning-suite/; app address the suite drives (blank uses the hosted app named in the scripts)
COSIGN_BASE_URL=http://localhost:3000

# optional · supabase · script only: scripts/positioning-suite/; email of the test account the suite signs in as
E2E_EMAIL=

# optional · supabase · script only: scripts/positioning-suite/; password of that test account; keep it secret
E2E_PASSWORD=

# optional · none · script only: scripts/positioning-suite/; any value sends the browser through HTTPS_PROXY
PLAYWRIGHT_PROXY=

# optional · none · script only: scripts/positioning-suite/; path to a Chromium binary for Playwright (default: Playwright's own)
PLAYWRIGHT_CHROMIUM=

# optional · none · script only: scripts/positioning-suite/; set by the platform or your shell: proxy used when PLAYWRIGHT_PROXY is set
# HTTPS_PROXY=
